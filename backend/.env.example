# Copy this file to .env for local development. Never commit the real .env.

# Local dev default (SQLite, zero setup). In production this is the
# Render Postgres "Internal Database URL".
DATABASE_URL=sqlite:///dev.db

# Generate a long random string for production, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-long-random-string

# How long a login stays valid.
JWT_EXPIRY_DAYS=30

# Comma-separated list of origins allowed to call this API.
ALLOWED_ORIGINS=https://robertkutwa.github.io,http://localhost:5500,http://127.0.0.1:5500
